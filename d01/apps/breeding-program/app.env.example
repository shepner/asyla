# breeding-program runtime settings (copied to ${DOCKER_DL}/breeding-program/app.env, mode 600, by `init`).
# Secrets are files under ../secrets (GOOGLE_APPLICATION_CREDENTIALS and SESSION_SECRET_FILE are set in compose.yml).
APP_ENV=prod
STORE_BACKEND=bigquery
BQ_PROJECT_ID=breeding-program
BQ_DATASET_ID=breeding_program
BQ_LOCATION=US
PUBLIC_BASE_URL=https://breeding-program.asyla.org
AUTH_MODE=cloudflare
CF_ACCESS_TEAM_DOMAIN=asyla.cloudflareaccess.com
# AUD tag of the dedicated "breeding-program" Access application (cloudflare-access.py prints it)
CF_ACCESS_AUD=
# May start a kennel; no admin rights (site admins are invited in the app; the first user on a site with none is one).
KENNEL_CREATOR_EMAILS=shepner@asyla.org
# Who LAN requests (via caddy-internal-d01, secrets/lan-trust-secret) act as. Everyone on the LAN is this person.
LAN_TRUST_EMAIL=shepner@asyla.org
DEFAULT_TIMEZONE=America/Chicago
