#!/bin/bash
# A Docker credential helper (the docker-credential-helpers protocol) for identity-platform.sh's
# pulls from gitea.asyla.org: `get` hands Docker the theorg-registry read:package token from this
# process's environment (IDENTITY_PLATFORM_REGISTRY_PULL_TOKEN, sent by the workstation at use:
# build_host.py pull_token_env), so no credential is ever written to a file. Read-only: store,
# erase and list refuse. Messages go to stderr and never name a value. As d06's ticketing helper.
set -u
NAME="IDENTITY_PLATFORM_REGISTRY_PULL_TOKEN"
USER_NAME="theorg-registry"

case "${1:-}" in
  get)
    server="$(cat)"
    server="${server//[$'\r\n\t ']/}"
    if ! [[ "$server" =~ ^[A-Za-z0-9.:/_-]+$ ]]; then
      echo "identity-platform-env: the server name is not a plain host name; refused" >&2
      exit 1
    fi
    value="${!NAME:-}"
    if [ -z "$value" ]; then
      echo "identity-platform-env: $NAME is not in this process's environment (the workstation sends it at use)" >&2
      exit 1
    fi
    if ! [[ "$value" =~ ^[A-Za-z0-9_.-]+$ ]]; then
      echo "identity-platform-env: $NAME holds characters outside [A-Za-z0-9_.-]; not used" >&2
      exit 1
    fi
    printf '{"ServerURL":"%s","Username":"%s","Secret":"%s"}\n' "$server" "$USER_NAME" "$value"
    ;;
  store|erase|list)
    echo "identity-platform-env: read-only helper; $1 refused" >&2
    exit 1
    ;;
  *)
    echo "usage: $0 get|store|erase|list" >&2
    exit 1
    ;;
esac
