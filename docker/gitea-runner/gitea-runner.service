# Installed to /etc/systemd/system/ by gitea-runner.sh install. Jobs run on the host as `docker`.
[Unit]
Description=Gitea Actions runner (asyla host jobs)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=docker
WorkingDirectory=/var/lib/gitea-runner
Environment=HOME=/home/docker
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/bin/gitea-runner daemon --config /var/lib/gitea-runner/config.yaml
Restart=always
RestartSec=10
# Longer than runner.shutdown_timeout, so a running job can finish on stop.
TimeoutStopSec=11min

[Install]
WantedBy=multi-user.target
