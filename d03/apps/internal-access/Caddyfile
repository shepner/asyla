# Internal reverse proxy for d03
# Pi-hole split DNS → d03. TLS: Let's Encrypt DNS-01 (CF_API_TOKEN in DATA_DIR .env).

(internal_tls) {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
        resolvers 1.1.1.1
    }
}

# HTTP for Cloudflare Tunnel (remote ingress → internal-proxy.asyla-edge.svc.cluster.local:80 via extra_hosts).
http://gitea.asyla.org {
    reverse_proxy gitea:3000 {
        header_up X-Forwarded-Proto https
    }
}
http://agent-commons.asyla.org {
    handle /mcp* {
        reverse_proxy agent-commons:8766
    }
    handle {
        reverse_proxy agent-commons:8765
    }
}
http://tc-datalogger.asyla.org {
    reverse_proxy tc-dashboard:8080
}
http://breeding-research.asyla.org {
    reverse_proxy breeding-research:8080
}

tc-datalogger.asyla.org {
    import internal_tls
    reverse_proxy tc-dashboard:8080
}

gitea.asyla.org {
    import internal_tls
    reverse_proxy gitea:3000 {
        header_up X-Forwarded-Proto https
    }
}

plane.asyla.org {
    import internal_tls
    reverse_proxy plane-proxy:80
}

vault.asyla.org {
    import internal_tls
    reverse_proxy openbao:8200
}

vikunja.asyla.org {
    import internal_tls
    reverse_proxy vikunja:3456
}

status.asyla.org {
    import internal_tls
    reverse_proxy uptime-kuma:3001
}

cq.asyla.org {
    import internal_tls
    reverse_proxy cq-team-ui:3000
}

agent-commons.asyla.org {
    import internal_tls
    handle /mcp* {
        reverse_proxy agent-commons:8766
    }
    handle {
        reverse_proxy agent-commons:8765
    }
}

breeding-research.asyla.org {
    import internal_tls
    reverse_proxy breeding-research:8080
}

:80 {
    respond "d03 internal proxy ready" 200
}
:443 {
    tls internal
    respond "d03 internal proxy ready" 200
}
