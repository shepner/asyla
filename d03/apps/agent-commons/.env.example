# Copy to compose dir as .env (not committed). Used by agent-commons.sh / compose.
DOCKER_DL=/mnt/docker
DOCKER_D1=/mnt/nas/data1/docker

# Local image tag (agent-commons.sh build/up uses host-native linux/amd64 or linux/arm64)
AGENT_COMMONS_IMAGE=agent-commons:local

# Git checkout with Dockerfile (default search paths if unset)
# AGENT_COMMONS_SRC=/home/you/local/asyla/projects/agent-commons

# Use Gitea registry instead of local build (must docker login gitea.asyla.org)
# AGENT_COMMONS_PULL=1
# AGENT_COMMONS_IMAGE=gitea.asyla.org/asyla/agent-commons:cb989764734bf3c41aefb61a5a04cec05ab4783f

# Optional API auth (match prior k3s Secret if used)
AGENT_COMMONS_API_TOKEN=
