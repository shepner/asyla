# Copy to compose dir as .env (not committed). Used by agent-commons.sh / compose.
DOCKER_DL=/mnt/docker
DOCKER_D1=/mnt/nas/data1/docker

# The deployed image is pinned in compose.yml (tracked), not here. Set this only to roll back to
# another local tag, and delete the line again afterwards (`verify` warns while it differs from the pin).
# AGENT_COMMONS_IMAGE=agent-commons:<sha7>

# `build` reads the source with git archive from the Gitea container's bare repo (defaults shown).
# AGENT_COMMONS_GIT_CONTAINER=gitea
# AGENT_COMMONS_GIT_DIR=/data/git/repositories/asyla/agent-commons.git

# Optional API auth (match prior k3s Secret if used)
AGENT_COMMONS_API_TOKEN=
