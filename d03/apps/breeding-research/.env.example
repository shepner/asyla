# Copy to .env (not committed).
DOCKER_DL=/mnt/docker
DOCKER_D1=/mnt/nas/data1/docker
LOCAL_TZ=America/Chicago

# No BREEDING_RESEARCH_IMAGE or BREEDING_RESEARCH_PULL: breeding-research.sh pulls
# gitea.asyla.org/personal/breeding-research:latest (its CI publishes it; gap G7: a rebuilt host
# needs no source clone) and ignores both here. By hand, in the call's environment:
# BREEDING_RESEARCH_IMAGE_OVERRIDE=<ref> pins another image; BREEDING_RESEARCH_PULL_OVERRIDE=0 builds
# breeding-research:local from the source in $SCRIPT_DIR/.src/breeding-research or BREEDING_RESEARCH_SRC.

BQ_PROJECT_ID=
BQ_DATASET_ID=
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
