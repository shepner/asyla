# Copy to .env (not committed).
DOCKER_DL=/mnt/docker
DOCKER_D1=/mnt/nas/data1/docker
LOCAL_TZ=America/Chicago

# Local build (default): breeding-research has no CI, so no registry image is published.
# Source: $SCRIPT_DIR/.src/breeding-research, or set BREEDING_RESEARCH_SRC.
BREEDING_RESEARCH_PULL=0
BREEDING_RESEARCH_IMAGE=breeding-research:local
# BREEDING_RESEARCH_SRC=/path/to/breeding-research

# Or pull a registry image: BREEDING_RESEARCH_PULL=1 and BREEDING_RESEARCH_IMAGE=<registry>/<name>:<tag>

BQ_PROJECT_ID=
BQ_DATASET_ID=
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
