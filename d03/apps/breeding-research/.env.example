# Copy to .env (not committed).
DOCKER_DL=/mnt/docker
DOCKER_D1=/mnt/nas/data1/docker
LOCAL_TZ=America/Chicago

# Registry image (d03, gap G7): breeding-research has no CI; its image is pushed to Gitea's registry
# by hand, and `up` pulls it, so a rebuilt host needs no source clone. Gitea's backup covers it.
BREEDING_RESEARCH_PULL=1
BREEDING_RESEARCH_IMAGE=gitea.asyla.org/personal/breeding-research:d03-migrate-20260530

# Or a local build: BREEDING_RESEARCH_PULL=0, BREEDING_RESEARCH_IMAGE=breeding-research:local, and the
# source in $SCRIPT_DIR/.src/breeding-research or BREEDING_RESEARCH_SRC=/path/to/breeding-research.

BQ_PROJECT_ID=
BQ_DATASET_ID=
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
